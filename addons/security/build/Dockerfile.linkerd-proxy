ARG WINDOWS_VERSION

FROM mcr.microsoft.com/windows/nanoserver:${WINDOWS_VERSION}

LABEL description='Linkerd data-plane proxy (Windows)'
LABEL k2s.io/linkerd-image-model=merged
LABEL k2s.io/linkerd-init-implementation=k2s-hns-noop

COPY ["release/linkerd2-proxy.exe", "/"]
COPY ["release/linkerd2-proxy-init.exe", "/usr/lib/linkerd/linkerd2-proxy-init.exe"]

USER ContainerAdministrator

# The merged chart invokes the extensionless path, so ship that name too.
RUN copy C:\usr\lib\linkerd\linkerd2-proxy-init.exe C:\usr\lib\linkerd\linkerd2-proxy-init

RUN net user /add "K2sSecurity" /expires:never
RUN net accounts /maxpwage:UNLIMITED
RUN net localgroup "Network Configuration Operators" "K2sSecurity" /add

# Both the proxy and the init container run unprivileged: the init binary is the
# K2s no-op (cmd/linkerdinit), the HNS redirection is programmed by the K2s CNI.
USER K2sSecurity

ENTRYPOINT ["linkerd2-proxy.exe"]
